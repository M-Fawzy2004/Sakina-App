{
    "surah": "القارعة",
    "number": 101,
    "ayahs": [
        {
            "ayah_number": 1,
            "text": "ٱلْقَارِعَةُ",
            "tafsir": [
                {
                    "type": "التفسير المختصر",
                    "text": "الساعة التي تقرع قلوب الناس بأهوالها."
                },
                {
                    "type": "تفسير الجلالين",
                    "text": "«القارعة» القيامة التي تقرع القلوب بأهوالها."
                },
                {
                    "type": "تفسير السعدي",
                    "text": "الساعة التي تقرع قلوب الناس بأهوالها."
                }
            ]
        },
        {
            "ayah_number": 2,
            "text": "مَا ٱلْقَارِعَةُ",
            "tafsir": [
                {
                    "type": "التفسير المختصر",
                    "text": "أيُّ شيء هذه القارعة؟"
                },
                {
                    "type": "تفسير الجلالين",
                    "text": "«ما القارعة» تهويل لشأنها وهما مبتدأ وخبر القارعة."
                },
                {
                    "type": "تفسير السعدي",
                    "text": "أيُّ شيء هذه القارعة؟"
                }
            ]
        },
        {
            "ayah_number": 3,
            "text": "وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ",
            "tafsir": [
                {
                    "type": "التفسير المختصر",
                    "text": "وأيُّ شيء أعلمك بها؟"
                },
                {
                    "type": "تفسير الجلالين",
                    "text": "«وما أدراك» أعلمك «ما القارعة» زيادة تهويل لها وما الأولى مبتدأ وما بعدها خبره وما الثانية وخبرها في محل المفعول الثاني لأدرى."
                },
                {
                    "type": "تفسير السعدي",
                    "text": "وأيُّ شيء أعلمك بها؟"
                }
            ]
        },
        {
            "ayah_number": 4,
            "text": "يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ",
            "tafsir": [
                {
                    "type": "التفسير المختصر",
                    "text": "في ذلك اليوم يكون الناس في كثرتهم وتفرقهم وحركتهم كالفراش المنتشر، وهو الذي يتساقط في النار."
                },
                {
                    "type": "تفسير الجلالين",
                    "text": "«يوم» ناصبه دل عليه القارعة، أي تقرع «يكون الناس كالفراش المبثوث» كغوغاء الجراد المنتشر يموج بعضهم في بعض للحيرة إلى أن يُدعوا للحساب."
                },
                {
                    "type": "تفسير السعدي",
                    "text": "في ذلك اليوم يكون الناس في كثرتهم وتفرقهم وحركتهم كالفراش المنتشر، وهو الذي يتساقط في النار."
                }
            ]
        },
        {
            "ayah_number": 5,
            "text": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ",
            "tafsir": [
                {
                    "type": "التفسير المختصر",
                    "text": "وتكون الجبال كالصوف متعدد الألوان الذي يُنْفَش باليد، فيصير هباء ويزول."
                },
                {
                    "type": "تفسير الجلالين",
                    "text": "«وتكون الجبال كالعهن المنفوش» كالصوف المندوف في خفة سيرها حتى تستوي مع الأرض."
                },
                {
                    "type": "تفسير السعدي",
                    "text": "وتكون الجبال كالصوف متعدد الألوان الذي يُنْفَش باليد، فيصير هباء ويزول."
                }
            ]
        },
        {
            "ayah_number": 6,
            "text": "فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ",
            "tafsir": [
                {
                    "type": "التفسير المختصر",
                    "text": "فأما من رجحت موازين حسناته، فهو في حياة مرضية في الجنة."
                },
                {
                    "type": "تفسير الجلالين",
                    "text": "«فأما من ثقلت موازينه» بأن رجحت حسناته على سيئاته."
                },
                {
                    "type": "تفسير السعدي",
                    "text": "فأما من رجحت موازين حسناته، فهو في حياة مرضية في الجنة."
                }
            ]
        },
        {
            "ayah_number": 7,
            "text": "فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ",
            "tafsir": [
                {
                    "type": "التفسير المختصر",
                    "text": "فأما من رجحت موازين حسناته، فهو في حياة مرضية في الجنة."
                },
                {
                    "type": "تفسير الجلالين",
                    "text": "«فهو في عيشة راضية» في الجنة، أي ذات رضى بأن يرضاها، أي مرضية له."
                },
                {
                    "type": "تفسير السعدي",
                    "text": "فأما من رجحت موازين حسناته، فهو في حياة مرضية في الجنة."
                }
            ]
        },
        {
            "ayah_number": 8,
            "text": "وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ",
            "tafsir": [
                {
                    "type": "التفسير المختصر",
                    "text": "وأما من خفت موازين حسناته، ورجحت موازين سيئاته، فمأواه جهنم."
                },
                {
                    "type": "تفسير الجلالين",
                    "text": "«وأما من خفَّت موازينه» بأن رجحت سيئاته على حسناته."
                },
                {
                    "type": "تفسير السعدي",
                    "text": "وأما من خفت موازين حسناته، ورجحت موازين سيئاته، فمأواه جهنم."
                }
            ]
        },
        {
            "ayah_number": 9,
            "text": "فَأُمُّهُۥ هَاوِيَةٌۭ",
            "tafsir": [
                {
                    "type": "التفسير المختصر",
                    "text": "وأما من خفت موازين حسناته، ورجحت موازين سيئاته، فمأواه جهنم."
                },
                {
                    "type": "تفسير الجلالين",
                    "text": "«فأمه» فمسكنه «هاوية»."
                },
                {
                    "type": "تفسير السعدي",
                    "text": "وأما من خفت موازين حسناته، ورجحت موازين سيئاته، فمأواه جهنم."
                }
            ]
        },
        {
            "ayah_number": 10,
            "text": "وَمَآ أَدْرَىٰكَ مَا هِيَهْ",
            "tafsir": [
                {
                    "type": "التفسير المختصر",
                    "text": "وما أدراك -أيها الرسول- ما هذه الهاوية؟"
                },
                {
                    "type": "تفسير الجلالين",
                    "text": "«وما أدراك ماهيه» أي ما هاوية."
                },
                {
                    "type": "تفسير السعدي",
                    "text": "وما أدراك -أيها الرسول- ما هذه الهاوية؟"
                }
            ]
        },
        {
            "ayah_number": 11,
            "text": "نَارٌ حَامِيَةٌۢ",
            "tafsir": [
                {
                    "type": "التفسير المختصر",
                    "text": "إنها نار قد حَمِيت من الوقود عليها."
                },
                {
                    "type": "تفسير الجلالين",
                    "text": "هي «نار حامية» شديدة الحرارة وهاء هيَهْ للسكت تثبت وصلا ووقفا وفي قراءة تحذف وصلاً."
                },
                {
                    "type": "تفسير السعدي",
                    "text": "إنها نار قد حَمِيت من الوقود عليها."
                }
            ]
        }
    ]
}