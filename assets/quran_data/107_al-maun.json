{
    "surah": "الماعون",
    "number": 107,
    "ayahs": [
        {
            "ayah_number": 1,
            "text": "أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ",
            "tafsir": [
                {
                    "type": "التفسير المختصر",
                    "text": "أرأيت حال ذلك الذي يكذِّب بالبعث والجزاء؟"
                },
                {
                    "type": "تفسير الجلالين",
                    "text": "«أرأيت الذي يُكذِّب بالدين» بالجزاء والحساب، أي هل عرفته وإن لم تعرفه."
                },
                {
                    "type": "تفسير السعدي",
                    "text": "أرأيت حال ذلك الذي يكذِّب بالبعث والجزاء؟"
                }
            ]
        },
        {
            "ayah_number": 2,
            "text": "فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ",
            "tafsir": [
                {
                    "type": "التفسير المختصر",
                    "text": "فذلك الذي يدفع اليتيم بعنف وشدة عن حقه؛ لقساوة قلبه."
                },
                {
                    "type": "تفسير الجلالين",
                    "text": "«فذلك» بتقدير هو بعد الفاء «الذي يَدُعُّ اليتيم» أي يدفعه بعنف عن حقه."
                },
                {
                    "type": "تفسير السعدي",
                    "text": "فذلك الذي يدفع اليتيم بعنف وشدة عن حقه؛ لقساوة قلبه."
                }
            ]
        },
        {
            "ayah_number": 3,
            "text": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ",
            "tafsir": [
                {
                    "type": "التفسير المختصر",
                    "text": "ولا يحضُّ غيره على إطعام المسكين، فكيف له أن يطعمه بنفسه؟"
                },
                {
                    "type": "تفسير الجلالين",
                    "text": "«ولا يحض» نفسه ولا غيره «على طعام المسكين» أي إطعامه، نزلت في العاص بن وائل أو الوليد بن المغيرة."
                },
                {
                    "type": "تفسير السعدي",
                    "text": "ولا يحضُّ غيره على إطعام المسكين، فكيف له أن يطعمه بنفسه؟"
                }
            ]
        },
        {
            "ayah_number": 4,
            "text": "فَوَيْلٌۭ لِّلْمُصَلِّينَ",
            "tafsir": [
                {
                    "type": "التفسير المختصر",
                    "text": "فعذاب شديد للمصلين الذين هم عن صلاتهم لاهون، لا يقيمونها على وجهها، ولا يؤدونها في وقتها."
                },
                {
                    "type": "تفسير الجلالين",
                    "text": "«فويل للمصلين»."
                },
                {
                    "type": "تفسير السعدي",
                    "text": "فعذاب شديد للمصلين الذين هم عن صلاتهم لاهون، لا يقيمونها على وجهها، ولا يؤدونها في وقتها."
                }
            ]
        },
        {
            "ayah_number": 5,
            "text": "ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ",
            "tafsir": [
                {
                    "type": "التفسير المختصر",
                    "text": "فعذاب شديد للمصلين الذين هم عن صلاتهم لاهون، لا يقيمونها على وجهها، ولا يؤدونها في وقتها."
                },
                {
                    "type": "تفسير الجلالين",
                    "text": "«الذين هم عن صلاتهم ساهون» غافلون يؤخرونها عن وقتها."
                },
                {
                    "type": "تفسير السعدي",
                    "text": "فعذاب شديد للمصلين الذين هم عن صلاتهم لاهون، لا يقيمونها على وجهها، ولا يؤدونها في وقتها."
                }
            ]
        },
        {
            "ayah_number": 6,
            "text": "ٱلَّذِينَ هُمْ يُرَآءُونَ",
            "tafsir": [
                {
                    "type": "التفسير المختصر",
                    "text": "الذين هم يتظاهرون بأعمال الخير مراءاة للناس."
                },
                {
                    "type": "تفسير الجلالين",
                    "text": "«الذين هم يراءون» في الصلاة وغيرها."
                },
                {
                    "type": "تفسير السعدي",
                    "text": "الذين هم يتظاهرون بأعمال الخير مراءاة للناس."
                }
            ]
        },
        {
            "ayah_number": 7,
            "text": "وَيَمْنَعُونَ ٱلْمَاعُونَ",
            "tafsir": [
                {
                    "type": "التفسير المختصر",
                    "text": "ويمنعون إعارة ما لا تضر إعارته من الآنية وغيرها، فلا هم أحسنوا عبادة ربهم، ولا هم أحسنوا إلى خلقه."
                },
                {
                    "type": "تفسير الجلالين",
                    "text": "«ويمنعون الماعون» كالإبرة والفأس والقدر والقصعة."
                },
                {
                    "type": "تفسير السعدي",
                    "text": "ويمنعون إعارة ما لا تضر إعارته من الآنية وغيرها، فلا هم أحسنوا عبادة ربهم، ولا هم أحسنوا إلى خلقه."
                }
            ]
        }
    ]
}